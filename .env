# IP Pública Estática de tu instancia AWS Lightsail (o tu nombre de dominio)
# Ejemplo: WG_HOST=54.210.100.20
WG_HOST=TU_IP_PUBLICA_LIGHTSAIL

# Contraseña de acceso al panel web (Web UI en http://TU_IP:51821)
PASSWORD=MiContrasenaSegura2026!

# Puerto UDP de WireGuard (debe coincidir con la regla UDP del firewall de Lightsail)
WG_PORT=51820

# Servidores DNS para los clientes de la VPN
WG_DEFAULT_DNS=1.1.1.1, 8.8.8.8

# Rango de tráfico (0.0.0.0/0, ::/0 enruta todo el tráfico de internet a través de la VPN)
WG_ALLOWED_IPS=0.0.0.0/0, ::/0
